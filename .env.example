# Copie este arquivo para ".env" e preencha com os dados reais do seu ambiente.

# Django
SECRET_KEY=troque-por-uma-chave-secreta-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
# Ative apenas quando houver HTTPS na frente (ex.: nginx com TLS)
SECURE_SSL=False

# Banco de dados (deixe DB_ENGINE vazio para usar SQLite localmente)
DB_ENGINE=postgres
DB_NAME=desafio_eqs
DB_USER=desafio_eqs
DB_PASSWORD=desafio_eqs
DB_HOST=db
DB_PORT=5432

# GLPI: se estas variáveis não forem configuradas, o sistema usa integração simulada (mock).
GLPI_API_URL=https://seu-glpi.exemplo.com/apirest.php
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=
